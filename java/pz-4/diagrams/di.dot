digraph G {
  rankdir=BT; nodesep=0.4; ranksep=0.8; compound=true;
  graph [fontname="Liberation Sans", bgcolor="white"];
  node [shape=record, fontname="Liberation Sans", fontsize=11, style=filled, fillcolor="#f5f5f5"];
  edge [fontname="Liberation Sans", fontsize=10];

  subgraph cluster_before {
    label="До: сервіс сам створює залежність"; style=rounded; fontsize=12;
    bS [label="{NotificationService|- notifier = new EmailNotifier()\l}"];
    bE [label="{EmailNotifier|+ send(message)\l}"];
    bS -> bE [label=" створює і залежить"];
  }
  subgraph cluster_after {
    label="Після: залежність через конструктор"; style=rounded; fontsize=12;
    aS [fillcolor="#dbe9ff", label="{NotificationService|- notifier : Notifier\l|+ NotificationService(Notifier)\l}"];
    aN [fillcolor="#fde9c9", label="{«interface»\nNotifier|+ send(message)\l}"];
    aE [label="{EmailNotifier|+ send(message)\l}"];
    aM [label="{SmsNotifier|+ send(message)\l}"];
    aMain [fillcolor="#d6f0d2", label="{Main|створює реалізацію\lі передає сервісу\l}"];
    aS -> aN [arrowhead=vee, style=dashed, label=" залежить лише від\l інтерфейсу"];
    aE -> aN [arrowhead=empty];
    aM -> aN [arrowhead=empty];
    aMain -> aS [arrowhead=vee, style=dashed, label=" new NotificationService(…)"];
  }
}
