digraph G {
  rankdir=BT; nodesep=0.6; ranksep=0.9;
  graph [fontname="Liberation Sans", bgcolor="white"];
  node [shape=record, fontname="Liberation Sans", fontsize=11, style=filled, fillcolor="#f5f5f5"];
  edge [fontname="Liberation Sans", fontsize=10];

  Document [fillcolor="#fde9c9", label="{«abstract»\nDocument|# title : String\l|«abstract» render() : String\l+ info() : String\l}"];
  Report [label="{Report|+ render() : String\l+ print()\l+ export()\l+ describe() : String\l}"];
  Letter [label="{Letter|- addressee : String\l|+ render() : String\l}"];
  Printable [fillcolor="#dbe9ff", label="{«interface»\nPrintable||+ print()\l«default» describe() : String\l}"];
  Exportable [fillcolor="#dbe9ff", label="{«interface»\nExportable||+ export()\l«default» describe() : String\l}"];

  Report -> Document [arrowhead=empty, label=" extends"];
  Letter -> Document [arrowhead=empty, label=" extends"];
  Report -> Printable [arrowhead=empty, style=dashed, label=" implements"];
  Report -> Exportable [arrowhead=empty, style=dashed, label=" implements"];
}
