@startuml
skinparam dpi 140
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam ArrowColor #333333
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
start
:Files.lines(файл, UTF-8)\nskip(1): пропустити заголовок\nfilter(рядок не порожній)\nmap(Issue::parse): рядок у Issue\ntoList(): усі записи (40);
:distinct(): прибрати повні повтори\nунікальні записи (36);
partition "Підсумки" {
  :groupingBy(Issue::status, TreeMap::new,\nsummarizingInt(Issue::storyPoints))\nпідсумки за статусами;
}
partition "Топ-5" {
  :sorted(за story points спадно, далі за ключем)\nlimit(5)\nтоп-5;
}
partition "Пошук" {
  :filter(ключ збігається)\nfindFirst()\nmap(Issue::toString)\norElse("не знайдено")\nрезультат пошуку;
}
stop
@enduml
