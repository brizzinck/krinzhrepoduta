@startuml
skinparam dpi 140
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #333333
skinparam ArrowColor #333333
hide empty members
left to right direction
class Sprint {
  + canAdd(points : int, current : int) : boolean
}
class IssueService {
  + plan(login : String, points : int) : boolean
}
interface TeamDirectory {
  + currentPoints(login : String) : int
}
interface ChatNotifier {
  + send(login : String, text : String)
}
class IssueServiceTest <<тест>>
class "mock TeamDirectory\n(стаб: when/thenReturn)" as StubDir <<Mockito>>
class "mock ChatNotifier\n(мок: verify)" as MockNot <<Mockito>>
IssueService --> Sprint
IssueService --> TeamDirectory
IssueService --> ChatNotifier
IssueServiceTest ..> IssueService
StubDir ..|> TeamDirectory
MockNot ..|> ChatNotifier
IssueServiceTest ..> StubDir
IssueServiceTest ..> MockNot
@enduml
