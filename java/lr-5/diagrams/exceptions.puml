@startuml
skinparam dpi 140
skinparam nodesep 20
skinparam ranksep 30

skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ArrowColor #333333
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
hide empty members

class Exception <<java.lang>>

class InvalidStockItemException <<domain>> {
}
class RecordFormatException <<parse>> {
  -lineNumber : long
  +lineNumber() : long
}
class ImportFailedException <<app>> {
}

Exception <|-- InvalidStockItemException
Exception <|-- RecordFormatException
Exception <|-- ImportFailedException

class StockItem <<domain>> {
  +{static} create(article, quantity, price)
}
class StockItemParser <<parse>> {
  +parse(line, lineNumber)
}
class StockImporter <<app>> {
  +importFile(input, output, onRejected)
}
class Main <<app>> {
  +{static} main(args)
}

StockItem ..> InvalidStockItemException : кидає
StockItemParser ..> StockItem : create()
StockItemParser ..> RecordFormatException : кидає, cause:\nInvalidStockItem-\nException або\nNumberFormatException
StockImporter ..> StockItemParser
StockImporter ..> RecordFormatException : ловить\nу циклі
StockImporter ..> ImportFailedException : кидає,\ncause: IOException
Main ..> StockImporter
Main ..> ImportFailedException : ловить
@enduml
