<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Захист сховища"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Оберіть один обов’язковий спосіб входу. Пропустити налаштування не можна." />
        <RadioGroup
            android:id="@+id/radioGroupSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <RadioButton
                android:id="@+id/radioPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIN-код" />
            <RadioButton
                android:id="@+id/radioBiometric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Біометрія пристрою" />
        </RadioGroup>
        <LinearLayout
            android:id="@+id/pinFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">
            <EditText
                android:id="@+id/editPinCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PIN: 4–8 цифр"
                android:inputType="numberPassword"
                android:maxLength="8" />
            <EditText
                android:id="@+id/editPinConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Повторіть PIN"
                android:inputType="numberPassword"
                android:maxLength="8" />
        </LinearLayout>
        <Button
            android:id="@+id/btnSaveSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Зберегти спосіб захисту" />
    </LinearLayout>
</ScrollView>
