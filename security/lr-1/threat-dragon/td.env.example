# Приклад конфігурації; справжні значення створює run.sh (td.env у репозиторій не додається)
NODE_ENV=production
PORT=3000
SERVER_API_PROTOCOL=http
LOG_LEVEL=info
ENCRYPTION_JWT_SIGNING_KEY=<випадковий рядок>
ENCRYPTION_JWT_REFRESH_SIGNING_KEY=<випадковий рядок>
ENCRYPTION_KEYS=[{"isPrimary": true, "id": 0, "value": "<32 випадкові hex-символи>"}]
