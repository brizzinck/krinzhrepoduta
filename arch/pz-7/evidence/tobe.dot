digraph tobe {
  rankdir=LR; fontname="DejaVu Sans"; nodesep=0.18; ranksep=0.35;
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.08,0.05"];
  edge [fontname="DejaVu Sans", fontsize=10];
  c [label="Клієнт", fillcolor="#eeeeee"];
  subgraph cluster_p { label="Модульний моноліт: один процес"; style="rounded,dashed"; fontname="DejaVu Sans"; fontsize=12;
    w [label="WebApi", fillcolor="#dbeafe"];
    r [label="Модуль Rentals", fillcolor="#d9f2d9"];
    f [label="Модуль Fleet", fillcolor="#d9f2d9"];
    o [label="Outbox\n(таблиця + фоновий читач)", fillcolor="#fecaca"];
    n [label="Модуль Notifications", fillcolor="#fff3b0"]; }
  d [label="Одна БД\nокремі схеми модулів", shape=cylinder, fillcolor="#eeeeee"];
  c -> w [label="REST"]; w -> r; w -> f;
  r -> f [label="публічний контракт\n(синхронно)"];
  r -> o [label="подія в транзакції"]; o -> f [label="подія"]; o -> n [label="подія"];
  r -> d; f -> d; o -> d;
}
