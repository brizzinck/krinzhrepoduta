<Project>
  <!-- Спільні параметри всіх проєктів: цільова платформа змінюється в одному місці. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- AutoMapper 14 є останньою версією під MIT; з 15 потрібна ліцензія. Вразливість стосується дуже глибоких
         графів об'єктів, що посилаються на свій тип. Таких типів у наших мапінгах немає. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
