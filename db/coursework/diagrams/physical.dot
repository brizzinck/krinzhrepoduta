digraph physical {
  rankdir=TB; nodesep=0.5; ranksep=0.9; pad=0.2; splines=true; newrank=true;
  node [shape=plain, fontname="DejaVu Sans", fontsize=16]; edge [fontname="DejaVu Sans", fontsize=13, dir=both, penwidth=1.3];
  customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="last_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="first_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT">varchar(13)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT" PORT="email_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at">registered_at</TD><TD ALIGN="LEFT">datetime</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="registered_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="diia_verified_at">diia_verified_at</TD><TD ALIGN="LEFT">datetime</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT" PORT="diia_verified_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_customers_last_name (last_name)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_customers_email (email)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_customers_phone (phone)</FONT></TD></TR></TABLE>>];
  operators [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>operators</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT">varchar(13)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="email_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="commission_pct">commission_pct</TD><TD ALIGN="LEFT">decimal(4,2)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="commission_pct_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_operators_name (name)</FONT></TD></TR></TABLE>>];
  payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>payments</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="customer_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ride_id">ride_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT" PORT="ride_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT">tinyint uns.</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="kind_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount_kop">amount_kop</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="amount_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT">datetime</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="created_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_payments_customer (customer_id, created_at)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_payments_ride_customer (ride_id, customer_id)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_payments_ride_kind (ride_id, kind)</FONT></TD></TR></TABLE>>];
  rides [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>rides</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="customer_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_id">vehicle_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="vehicle_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at">started_at</TD><TD ALIGN="LEFT">datetime</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="started_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at">ended_at</TD><TD ALIGN="LEFT">datetime</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT" PORT="ended_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unlock_fee_kop">unlock_fee_kop</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="unlock_fee_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="per_minute_kop">per_minute_kop</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="per_minute_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="commission_kop">commission_kop</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT" PORT="commission_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_rides_customer (customer_id, started_at)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_rides_ended_at (ended_at)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_rides_started_at (started_at)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_rides_vehicle (vehicle_id, started_at)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_rides_id_customer (id, customer_id)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE ux_rides_active_customer (case when (ended_at is null) then customer_id end)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE ux_rides_active_vehicle (case when (ended_at is null) then vehicle_id end)</FONT></TD></TR></TABLE>>];
  stations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>stations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT">varchar(60)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="address_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity">capacity</TD><TD ALIGN="LEFT">tinyint uns.</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="capacity_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_stations_name (name)</FONT></TD></TR></TABLE>>];
  tariffs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>tariffs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="operator_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_type">vehicle_type</TD><TD ALIGN="LEFT">tinyint uns.</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="vehicle_type_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unlock_fee_kop">unlock_fee_kop</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="unlock_fee_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="per_minute_kop">per_minute_kop</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="per_minute_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_tariffs_operator_type (operator_id, vehicle_type)</FONT></TD></TR></TABLE>>];
  vehicles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe5f7"><B>vehicles</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK, AUTO_INC</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT">varchar(8)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="code_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="operator_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_type">vehicle_type</TD><TD ALIGN="LEFT">tinyint uns.</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="vehicle_type_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model">model</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="model_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="battery_pct">battery_pct</TD><TD ALIGN="LEFT">tinyint uns.</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="battery_pct_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT">tinyint uns.</TD><TD ALIGN="LEFT">NOT NULL</TD><TD ALIGN="LEFT" PORT="status_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="station_id">station_id</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">NULL</TD><TD ALIGN="LEFT" PORT="station_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f1f1f1"><I>Індекси (крім первинного ключа)</I></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_vehicles_operator_type (operator_id, vehicle_type)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">ix_vehicles_station (station_id)</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT"><FONT POINT-SIZE="13">UNIQUE uq_vehicles_code (code)</FONT></TD></TR></TABLE>>];
  customers -> payments [arrowtail=teetee, arrowhead=crowodot, label="fk_payments_customer\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(customer_id = id)"];
  rides -> payments [arrowtail=teeodot, arrowhead=crowodot, label="fk_payments_ride_customer\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(ride_id = id, customer_id = customer_id)"];
  customers -> rides [arrowtail=teetee, arrowhead=crowodot, label="fk_rides_customer\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(customer_id = id)"];
  vehicles -> rides [arrowtail=teetee, arrowhead=crowodot, label="fk_rides_vehicle\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(vehicle_id = id)"];
  operators -> tariffs [arrowtail=teetee, arrowhead=crowodot, label="fk_tariffs_operator\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(operator_id = id)"];
  operators -> vehicles [arrowtail=teetee, arrowhead=crowodot, label="fk_vehicles_operator\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(operator_id = id)"];
  stations -> vehicles [arrowtail=teeodot, arrowhead=crowodot, label="fk_vehicles_station\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(station_id = id)"];
  tariffs -> vehicles [arrowtail=teetee, arrowhead=crowodot, label="fk_vehicles_tariff\nON DELETE RESTRICT, ON UPDATE RESTRICT\n(operator_id = operator_id, vehicle_type = vehicle_type)"];
  legend [shape=note, fontsize=13, margin="0.15,0.1", label="Коди стовпців (список зберігається в застосунку як enum, у БД діапазон перевіряє CHECK):\ltariffs.vehicle_type, vehicles.vehicle_type: 1 E_SCOOTER Електросамокат; 2 E_BIKE Електровелосипед\lvehicles.status: 1 AVAILABLE Чекає клієнта; 2 IN_RIDE У поїздці; 3 CHARGING На зарядці; 4 REPAIR У ремонті; 5 RETIRED Списано\lpayments.kind: 1 BONUS Бонус за реєстрацію; 2 TOPUP Поповнення; 3 RIDE Оплата поїздки; 4 REFUND Повернення за поїздку\lPK первинний ключ, FK зовнішній, UQ унікальний, AUTO_INC автоінкремент. Усі зовнішні ключі RESTRICT.\l"];
  {rank=same; payments; legend}
}
