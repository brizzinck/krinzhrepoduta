digraph datalogical {
  rankdir=TB; nodesep=0.5; ranksep=0.9; pad=0.2; splines=true; newrank=true;
  node [shape=plain, fontname="DejaVu Sans", fontsize=18]; edge [fontname="DejaVu Sans", fontsize=14, dir=both, penwidth=1.3];
  customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT" PORT="last_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT" PORT="first_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email *</TD><TD ALIGN="LEFT" PORT="email_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at">registered_at</TD><TD ALIGN="LEFT" PORT="registered_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="diia_verified_at">diia_verified_at *</TD><TD ALIGN="LEFT" PORT="diia_verified_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  operators [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>operators</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT" PORT="email_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="commission_pct">commission_pct</TD><TD ALIGN="LEFT" PORT="commission_pct_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>payments</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT" PORT="customer_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ride_id">ride_id *</TD><TD ALIGN="LEFT" PORT="ride_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT" PORT="kind_r"><FONT COLOR="#a00000">код</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount_kop">amount_kop</TD><TD ALIGN="LEFT" PORT="amount_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD><TD ALIGN="LEFT" PORT="created_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#a00000">UQ (ride_id, kind)</FONT></TD></TR></TABLE>>];
  rides [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>rides</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT" PORT="customer_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_id">vehicle_id</TD><TD ALIGN="LEFT" PORT="vehicle_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="started_at">started_at</TD><TD ALIGN="LEFT" PORT="started_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ended_at">ended_at *</TD><TD ALIGN="LEFT" PORT="ended_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unlock_fee_kop">unlock_fee_kop</TD><TD ALIGN="LEFT" PORT="unlock_fee_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="per_minute_kop">per_minute_kop</TD><TD ALIGN="LEFT" PORT="per_minute_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="commission_kop">commission_kop *</TD><TD ALIGN="LEFT" PORT="commission_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#a00000">UQ (id, customer_id)</FONT></TD></TR></TABLE>>];
  stations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>stations</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT" PORT="address_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="capacity">capacity</TD><TD ALIGN="LEFT" PORT="capacity_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  tariffs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>tariffs</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT" PORT="operator_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_type">vehicle_type</TD><TD ALIGN="LEFT" PORT="vehicle_type_r"><FONT COLOR="#a00000">код</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unlock_fee_kop">unlock_fee_kop</TD><TD ALIGN="LEFT" PORT="unlock_fee_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="per_minute_kop">per_minute_kop</TD><TD ALIGN="LEFT" PORT="per_minute_kop_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT COLOR="#a00000">UQ (operator_id, vehicle_type)</FONT></TD></TR></TABLE>>];
  vehicles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>vehicles</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><U>id</U></TD><TD ALIGN="LEFT" PORT="id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT" PORT="code_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="operator_id">operator_id</TD><TD ALIGN="LEFT" PORT="operator_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_type">vehicle_type</TD><TD ALIGN="LEFT" PORT="vehicle_type_r"><FONT COLOR="#a00000">FK, код</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model">model</TD><TD ALIGN="LEFT" PORT="model_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="battery_pct">battery_pct</TD><TD ALIGN="LEFT" PORT="battery_pct_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT" PORT="status_r"><FONT COLOR="#a00000">код</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="station_id">station_id *</TD><TD ALIGN="LEFT" PORT="station_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR></TABLE>>];
  customers -> payments [arrowtail=teetee, arrowhead=crowtee, label="holds\nbelongs_to\n(customer_id = id)"];
  rides -> payments [arrowtail=teeodot, arrowhead=crowodot, label="is_settled_by\nsettles\n(ride_id = id, customer_id = customer_id)"];
  customers -> rides [arrowtail=teetee, arrowhead=crowodot, label="takes\nis_taken_by\n(customer_id = id)"];
  vehicles -> rides [arrowtail=teetee, arrowhead=crowodot, label="is_used_in\nuses\n(vehicle_id = id)"];
  operators -> tariffs [arrowtail=teetee, arrowhead=crowodot, label="sets\nis_set_by\n(operator_id = id)"];
  operators -> vehicles [arrowtail=teetee, arrowhead=crowodot, label="owns\nis_owned_by\n(operator_id = id)"];
  stations -> vehicles [arrowtail=teeodot, arrowhead=crowodot, label="hosts\nis_parked_at\n(station_id = id)"];
  tariffs -> vehicles [arrowtail=teetee, arrowhead=crowodot, label="prices\nis_priced_by\n(operator_id = operator_id, vehicle_type = vehicle_type)"];
  legend [shape=note, fontsize=13, margin="0.15,0.1", label="Коди стовпців (список зберігається в застосунку як enum, у БД діапазон перевіряє CHECK):\ltariffs.vehicle_type, vehicles.vehicle_type: 1 E_SCOOTER Електросамокат; 2 E_BIKE Електровелосипед\lvehicles.status: 1 AVAILABLE Чекає клієнта; 2 IN_RIDE У поїздці; 3 CHARGING На зарядці; 4 REPAIR У ремонті; 5 RETIRED Списано\lpayments.kind: 1 BONUS Бонус за реєстрацію; 2 TOPUP Поповнення; 3 RIDE Оплата поїздки; 4 REFUND Повернення за поїздку\lСтовпець із зірочкою (*) допускає NULL. PK первинний ключ, FK зовнішній ключ, UQ унікальний.\l"];
  {rank=same; payments; legend}
}
