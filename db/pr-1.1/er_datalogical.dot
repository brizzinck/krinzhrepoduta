digraph datalogical {
  rankdir=LR; nodesep=0.25; ranksep=0.7; pad=0.2; splines=true;
  node [shape=plain, fontname="DejaVu Sans", fontsize=18]; edge [fontname="DejaVu Sans", fontsize=15, dir=both, penwidth=1.3];
  branches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>branches</B></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_id"><U>branch_id</U></TD><TD ALIGN="LEFT" PORT="branch_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT" PORT="city_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT" PORT="address_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  car_classes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>car_classes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="class_id"><U>class_id</U></TD><TD ALIGN="LEFT" PORT="class_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_base_rate">daily_base_rate</TD><TD ALIGN="LEFT" PORT="daily_base_rate_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="deposit_amount">deposit_amount</TD><TD ALIGN="LEFT" PORT="deposit_amount_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  car_models [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>car_models</B></TD></TR><TR><TD ALIGN="LEFT" PORT="model_id"><U>model_id</U></TD><TD ALIGN="LEFT" PORT="model_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="class_id">class_id</TD><TD ALIGN="LEFT" PORT="class_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="brand">brand</TD><TD ALIGN="LEFT" PORT="brand_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_name">model_name</TD><TD ALIGN="LEFT" PORT="model_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="seats">seats</TD><TD ALIGN="LEFT" PORT="seats_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="transmission">transmission</TD><TD ALIGN="LEFT" PORT="transmission_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fuel_type">fuel_type</TD><TD ALIGN="LEFT" PORT="fuel_type_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  cars [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>cars</B></TD></TR><TR><TD ALIGN="LEFT" PORT="car_id"><U>car_id</U></TD><TD ALIGN="LEFT" PORT="car_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_id">model_id</TD><TD ALIGN="LEFT" PORT="model_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_id">branch_id</TD><TD ALIGN="LEFT" PORT="branch_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vin">vin</TD><TD ALIGN="LEFT" PORT="vin_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="plate_number">plate_number</TD><TD ALIGN="LEFT" PORT="plate_number_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="manufacture_year">manufacture_year</TD><TD ALIGN="LEFT" PORT="manufacture_year_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mileage_km">mileage_km</TD><TD ALIGN="LEFT" PORT="mileage_km_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_price">daily_price</TD><TD ALIGN="LEFT" PORT="daily_price_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT" PORT="status_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id"><U>customer_id</U></TD><TD ALIGN="LEFT" PORT="customer_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name">first_name</TD><TD ALIGN="LEFT" PORT="first_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name">last_name</TD><TD ALIGN="LEFT" PORT="last_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="middle_name">middle_name *</TD><TD ALIGN="LEFT" PORT="middle_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT" PORT="email_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="birth_date">birth_date</TD><TD ALIGN="LEFT" PORT="birth_date_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="license_number">license_number</TD><TD ALIGN="LEFT" PORT="license_number_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="license_expires">license_expires</TD><TD ALIGN="LEFT" PORT="license_expires_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="registered_at">registered_at</TD><TD ALIGN="LEFT" PORT="registered_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  employees [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><U>employee_id</U></TD><TD ALIGN="LEFT" PORT="employee_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="branch_id">branch_id</TD><TD ALIGN="LEFT" PORT="branch_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT" PORT="full_name_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="position">position</TD><TD ALIGN="LEFT" PORT="position_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT" PORT="phone_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hired_at">hired_at</TD><TD ALIGN="LEFT" PORT="hired_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  extras [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>extras</B></TD></TR><TR><TD ALIGN="LEFT" PORT="extra_id"><U>extra_id</U></TD><TD ALIGN="LEFT" PORT="extra_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT" PORT="name_r"><FONT COLOR="#a00000">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="price_per_day">price_per_day</TD><TD ALIGN="LEFT" PORT="price_per_day_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>payments</B></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><U>payment_id</U></TD><TD ALIGN="LEFT" PORT="payment_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rental_id">rental_id</TD><TD ALIGN="LEFT" PORT="rental_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount</TD><TD ALIGN="LEFT" PORT="amount_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind">kind</TD><TD ALIGN="LEFT" PORT="kind_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="method">method</TD><TD ALIGN="LEFT" PORT="method_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paid_at">paid_at</TD><TD ALIGN="LEFT" PORT="paid_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  rental_extras [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>rental_extras</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rental_id"><U>rental_id</U></TD><TD ALIGN="LEFT" PORT="rental_id_r"><FONT COLOR="#a00000">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="extra_id"><U>extra_id</U></TD><TD ALIGN="LEFT" PORT="extra_id_r"><FONT COLOR="#a00000">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quantity">quantity</TD><TD ALIGN="LEFT" PORT="quantity_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  rentals [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#dbe5f7"><B>rentals</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rental_id"><U>rental_id</U></TD><TD ALIGN="LEFT" PORT="rental_id_r"><FONT COLOR="#a00000">PK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT" PORT="customer_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="car_id">car_id</TD><TD ALIGN="LEFT" PORT="car_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id">employee_id *</TD><TD ALIGN="LEFT" PORT="employee_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pickup_branch_id">pickup_branch_id</TD><TD ALIGN="LEFT" PORT="pickup_branch_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="return_branch_id">return_branch_id *</TD><TD ALIGN="LEFT" PORT="return_branch_id_r"><FONT COLOR="#a00000">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_at">start_at</TD><TD ALIGN="LEFT" PORT="start_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="planned_end_at">planned_end_at</TD><TD ALIGN="LEFT" PORT="planned_end_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actual_end_at">actual_end_at *</TD><TD ALIGN="LEFT" PORT="actual_end_at_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="daily_price">daily_price</TD><TD ALIGN="LEFT" PORT="daily_price_r"><FONT COLOR="#a00000"> </FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT" PORT="status_r"><FONT COLOR="#a00000"> </FONT></TD></TR></TABLE>>];
  car_classes:class_id_r:e -> car_models:class_id:w [arrowtail=teetee, arrowhead=crowodot, label="classifies"];
  branches:branch_id_r:e -> cars:branch_id:w [arrowtail=teetee, arrowhead=crowodot, label="is_stored_in"];
  car_models:model_id_r:e -> cars:model_id:w [arrowtail=teetee, arrowhead=crowodot, label="is_model_of"];
  branches:branch_id_r:e -> employees:branch_id:w [arrowtail=teetee, arrowhead=crowodot, label="employs"];
  rentals:rental_id_r:e -> payments:rental_id:w [arrowtail=teetee, arrowhead=crowodot, label="is_paid_by"];
  extras:extra_id_r:e -> rental_extras:extra_id:w [arrowtail=teetee, arrowhead=crowodot, label="is_added_in"];
  rentals:rental_id_r:e -> rental_extras:rental_id:w [arrowtail=teetee, arrowhead=crowodot, label="includes"];
  cars:car_id_r:e -> rentals:car_id:w [arrowtail=teetee, arrowhead=crowodot, label="is_rented_in"];
  customers:customer_id_r:e -> rentals:customer_id:w [arrowtail=teetee, arrowhead=crowodot, label="makes"];
  employees:employee_id_r:e -> rentals:employee_id:w [arrowtail=teeodot, arrowhead=crowodot, label="serves"];
  branches:branch_id_r:e -> rentals:pickup_branch_id:w [arrowtail=teetee, arrowhead=crowodot, label="hands_over"];
  branches:branch_id_r:e -> rentals:return_branch_id:w [arrowtail=teeodot, arrowhead=crowodot, label="receives"];
}
